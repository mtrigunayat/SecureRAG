# MCP Server Configuration

# MCP Server Network
MCP_HOST=0.0.0.0
MCP_PORT=5001

# Public URL (required for OAuth discovery by Claude)
# Local development: http://localhost:5000
# Production (Render): https://secure-rag-mcp.onrender.com
MCP_PUBLIC_URL=http://localhost:5000

# Backend Communication
BACKEND_URL=http://localhost:8000
BACKEND_API_TIMEOUT=30

# Logging
LOG_LEVEL=INFO

# Production Configuration (Render)
# ==============================
# Set the following when deploying to Render:
#
# MCP_PUBLIC_URL=https://secure-rag-mcp.onrender.com
# BACKEND_URL=https://securerag-backendd.onrender.com
# LOG_LEVEL=INFO
#
# Note: PORT is set automatically by Render based on available port

