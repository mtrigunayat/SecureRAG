# ============================================================================
# Secure RAG Knowledge Assistant - Environment Configuration
# ============================================================================
#
# This file contains all environment variables needed for deployment.
# Copy to .env and fill in your values.
#
# LOCAL DEVELOPMENT: Fill only required variables
# CLOUD DEPLOYMENT: Fill all variables with production URLs/credentials
#
# ============================================================================
# BACKEND APPLICATION
# ============================================================================

# Application environment
APP_ENV=development

# Application host and port (Render will override port via PORT environment variable)
APP_HOST=0.0.0.0
APP_PORT=8000

# Database connection (REQUIRED - must be a valid PostgreSQL connection string)
# Local development: postgresql://rag_user:rag_password@localhost:5432/secure_rag
# Cloud (Neon): postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/secure_rag

# ============================================================================
# VECTOR DATABASE (Qdrant)
# ============================================================================

# Qdrant URL
# Local development: http://localhost:6333
# Cloud: https://your-instance.qdrant.io:6333
QDRANT_URL=http://localhost:6333

# Qdrant API key (leave empty for local, required for Qdrant Cloud)
QDRANT_API_KEY=

# Qdrant collection name
QDRANT_COLLECTION_NAME=knowledge_chunks

# ============================================================================
# AZURE OPENAI (LLM SERVICE)
# ============================================================================

# Azure OpenAI API key
# Get from: https://portal.azure.com/ → Azure OpenAI → Keys
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here

# Azure OpenAI endpoint
# Format: https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Deployment name (default: gpt-4.1-mini, must match deployed model name in Azure)
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# API version (default: 2024-12-01-preview)
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# LLM Generation parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1000

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# JWT signing secret (MUST be at least 32 characters for production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-secret-key-minimum-32-characters-long

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT expiration (hours)
JWT_EXPIRATION_HOURS=1

# MCP token expiration (days)
MCP_TOKEN_EXPIRATION_DAYS=365

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Comma-separated list of allowed origins
# Local development: http://localhost:3000,http://localhost:5173
# Cloud: https://yourdomain.com,https://frontend.onrender.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# EMBEDDING MODEL
# ============================================================================

# Embedding model name (default: sentence-transformers/all-MiniLM-L6-v2)
# WARNING: Do NOT change without understanding vector dimension compatibility
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding dimension (default: 384 for all-MiniLM-L6-v2)
# WARNING: Must match the model's output dimension
EMBEDDING_DIMENSION=384

# ============================================================================
# RETRIEVAL SETTINGS
# ============================================================================

# Number of documents to retrieve for RAG
RETRIEVAL_TOP_K=5

# Minimum similarity score threshold (0.0 - 1.0)
RETRIEVAL_SCORE_THRESHOLD=0.7

# Chunk size for document indexing
CHUNK_SIZE=600

# Chunk overlap for document indexing
CHUNK_OVERLAP=100

# ============================================================================
# LOGGING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# MCP SERVER CONFIGURATION
# ============================================================================

# MCP server host (0.0.0.0 for all interfaces)
MCP_HOST=0.0.0.0

# MCP server port (Render will override via PORT environment variable)
MCP_PORT=5000

# Backend URL (for MCP server to communicate with FastAPI backend)
# Local: http://localhost:8000
# Cloud: https://my-backend.onrender.com
BACKEND_URL=http://localhost:8000

# Backend API timeout (seconds)
BACKEND_API_TIMEOUT=30
